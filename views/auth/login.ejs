<%- include('../layouts/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <article class="form-card">
      <h1>Connexion</h1>
      <p class="text-muted">Accédez à votre espace après vérification e-mail.</p>
      <form action="/login" method="post" novalidate>
        <div class="mb-3">
          <label class="form-label" for="email">E-mail</label>
          <input class="form-control" id="email" name="email" type="email" required />
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Mot de passe</label>
          <input class="form-control" id="password" name="password" type="password" required />
        </div>
        <button class="btn btn-gold w-100" type="submit">Se connecter</button>
      </form>
      <hr />
      <form action="/resend-verification" method="post">
        <label class="form-label" for="resendEmail">Renvoyer l’e-mail de vérification</label>
        <div class="input-group">
          <input class="form-control" id="resendEmail" name="email" type="email" required />
          <button class="btn btn-outline-gold" type="submit">Envoyer</button>
        </div>
      </form>
      <p class="mt-3 mb-0">Pas encore client ? <a href="/register">Ouvrir un compte</a></p>
    </article>
  </div>
</div>

<%- include('../layouts/footer') %>
