<% if (flash.success && flash.success.length) { %>
  <div class="alert alert-success" role="alert"><%= flash.success.join(' ') %></div>
<% } %>
<% if (flash.error && flash.error.length) { %>
  <div class="alert alert-danger" role="alert"><%= flash.error.join(' ') %></div>
<% } %>
<% if (flash.info && flash.info.length) { %>
  <div class="alert alert-info" role="alert"><%= flash.info.join(' ') %></div>
<% } %>
