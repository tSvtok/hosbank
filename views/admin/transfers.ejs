<%- include('../layouts/header') %>

<h1 class="mb-4">Virements et opérations</h1>
<section class="table-panel">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>De</th>
          <th>Vers</th>
          <th class="text-end">Montant</th>
          <th>Statut</th>
        </tr>
      </thead>
      <tbody>
        <% transfers.forEach(function (tx) { %>
          <tr>
            <td><%= new Date(tx.created_at).toLocaleString('fr-FR') %></td>
            <td><%= tx.label || tx.type %></td>
            <td><%= formatRib(tx.from_rib) || '—' %></td>
            <td><%= formatRib(tx.to_rib) || '—' %></td>
            <td class="text-end"><%= formatMoney(tx.amount) %></td>
            <td><%= tx.status %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../layouts/footer') %>
