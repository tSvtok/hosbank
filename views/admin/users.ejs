<%- include('../layouts/header') %>

<div class="d-flex justify-content-between align-items-end mb-4">
  <h1 class="mb-0">Utilisateurs</h1>
  <a class="btn btn-gold" href="/admin/users/new">Créer un utilisateur</a>
</div>
<section class="table-panel">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Nom</th>
          <th>E-mail</th>
          <th>Rôle</th>
          <th>Chargé client</th>
          <th>Statut</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function (item) { %>
          <tr>
            <td><%= item.first_name %> <%= item.last_name %></td>
            <td><%= item.email %></td>
            <td><%= item.role_label %></td>
            <td>
              <% if (item.role_name === 'client') { %>
                <form action="/admin/users/<%= item.id %>/manager" method="post" class="d-flex gap-2">
                  <select class="form-select form-select-sm" name="managerId">
                    <option value="">—</option>
                    <% managers.forEach(function (manager) { %>
                      <option value="<%= manager.id %>" <%= item.manager_id === manager.id ? 'selected' : '' %>>
                        <%= manager.first_name %> <%= manager.last_name %>
                      </option>
                    <% }) %>
                  </select>
                  <button class="btn btn-sm btn-outline-gold" type="submit">OK</button>
                </form>
              <% } else { %>
                —
              <% } %>
            </td>
            <td><%= item.status || (item.email_verified ? 'actif' : 'non vérifié') %></td>
            <td class="d-flex gap-2">
              <a class="btn btn-sm btn-outline-gold" href="/admin/users/<%= item.id %>/edit">Modifier</a>
              <% if (item.role_name !== 'admin') { %>
                <form action="/admin/users/<%= item.id %>/status" method="post">
                  <input type="hidden" name="status" value="<%= item.status === 'suspended' ? 'active' : 'suspended' %>" />
                  <button class="btn btn-sm btn-outline-gold" type="submit">
                    <%= item.status === 'suspended' ? 'Réactiver' : 'Désactiver' %>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../layouts/footer') %>
